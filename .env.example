# Public Supabase client config (safe to expose in the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase SAMAQU — hanya untuk channel Realtime wa_inbox (anon key aman di browser).
NEXT_PUBLIC_SAMAQU_SUPABASE_URL=
NEXT_PUBLIC_SAMAQU_SUPABASE_ANON_KEY=

# Never put a service_role key in NEXT_PUBLIC_* or in source.
# The seed script reads SUPABASE_SERVICE_ROLE_KEY from the shell only.
